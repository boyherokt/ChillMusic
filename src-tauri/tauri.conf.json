{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chill-Music",
  "version": "1.2.1",
  "identifier": "com.chill.music",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chill Music",
        "width": 1180,
        "height": 620,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": false,
        "x": 50,
        "y": 50,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}